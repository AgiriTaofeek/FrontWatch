node_modules/
.env*
# ...except a template committed on purpose (infra/self-hosted/.env.example,
# docs/08-operations-release/self-hosted-installation.md's own first step)
# — real values still never belong in source control, but the template
# documenting which ones exist should, the same way any other
# .env.example convention works. Found the gap while adding the first
# one this repo has ever had: the blanket ".env*" pattern above was
# silently swallowing it too.
!.env.example
!**/.env.example

# Go build artifacts
bin/
*.test
*.out

# TanStack Start / Vite build output — routeTree.gen.ts is
# regenerated from the routes/ directory on every dev/build run.
apps/web/src/routeTree.gen.ts
apps/web/.output/
apps/web/.vinxi/
apps/web/dist/

# Local Postgres backup dumps (scripts/backup-postgres.sh) — never
# committed, same reasoning as .env*: real customer data, even in a
# local dev backup, doesn't belong in source control.
backups/

# Load-testing session state and raw run output (loadtest/run.sh) —
# point-in-time local numbers, not something to commit and let go
# stale. .session also carries a live session cookie, same
# secrets-don't-belong-in-source-control reasoning as .env*.
loadtest/.session
loadtest/results/