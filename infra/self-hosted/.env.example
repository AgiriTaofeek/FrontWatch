# Copy to .env in this directory before building — docker compose
# reads .env automatically from the directory it's invoked with a
# -f/--project-directory in, or the directory this file lives in when
# run from here directly.
#
#   cp infra/self-hosted/.env.example infra/self-hosted/.env
#   # edit infra/self-hosted/.env with your real values
#   docker compose -f infra/self-hosted/docker-compose.yml --env-file infra/self-hosted/.env build
#   docker compose -f infra/self-hosted/docker-compose.yml --env-file infra/self-hosted/.env up -d

# Real secrets for anything beyond a local trial — never commit real
# values (this file is the template, not a live .env; .env itself is
# gitignored the same way .env* is everywhere else in this repo).
POSTGRES_PASSWORD=frontwatch_dev
CLICKHOUSE_PASSWORD=frontwatch_dev

# The dashboard's real origin, as a real browser will load it — used
# both to configure control-api's CORS allowlist (WEB_ORIGIN) and to
# bake the API's address into the dashboard's own build
# (VITE_API_BASE_URL). Change "localhost" to your real host/domain for
# anything beyond a single-machine trial.
WEB_ORIGIN=http://localhost:3001
VITE_API_BASE_URL=http://localhost:3000
